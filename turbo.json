{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "renders/**", ".thumbnails/**"],
      "env": ["SUPABASE_URL", "SUPABASE_ANON_KEY", "LOGO_DEV_TOKEN"]
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "env": ["SUPABASE_URL", "SUPABASE_ANON_KEY", "LOGO_DEV_TOKEN"]
    },
    "start": {
      "persistent": true,
      "cache": false,
      "env": ["SUPABASE_URL", "SUPABASE_ANON_KEY", "LOGO_DEV_TOKEN"]
    },
    "type-check": {
      "persistent": true,
      "cache": false
    }
  }
}
