{
  "name": "sp500-mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev --filter=./apps/*... --filter=!@apps/promo-video",
    "build": "turbo run build --filter=./apps/*... --filter=!@apps/promo-video",
    "build:promo": "turbo run build --filter=./apps/promo-video",
    "check:promo": "pnpm --filter @apps/promo-video check",
    "render:promo": "pnpm --filter @apps/promo-video render",
    "start": "turbo run start --filter=./apps/web...",
    "type-check": "turbo run type-check --filter=./apps/*...",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@supabase/supabase-js": "^2.108.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.17.0",
    "mcp-handler": "^1.1.0",
    "next": "^16.2.9",
    "ogl": "^1.0.11",
    "protocol-launcher": "^1.26.0",
    "radix-ui": "^1.5.0",
    "react": "^19.1.8",
    "react-dom": "^19.2.7",
    "redis": "^6.0.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint-react/eslint-plugin": "5.7.4",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@next/eslint-plugin-next": "^16.2.9",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-next": "^16.2.9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.0",
    "turbo": "^2.9.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.34.2"
}
